# ===== 运行参数 =====
# 宿主机映射端口
APP_PORT=3000
TZ=Asia/Shanghai
LOG_LEVEL=info

# ===== 安全 =====
# 加密 Telegram session 的密钥（>=16 位）。
# 留空时会在数据目录自动生成 /data/.session-secret，请勿随意更换，否则需重新登录。
SESSION_SECRET=

# 管理界面基础认证（可选，公网部署强烈建议开启）
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# ===== 构建 =====
# 国内网络可改为 https://registry.npmmirror.com
NPM_REGISTRY=https://registry.npmjs.org
