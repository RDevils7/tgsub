# ===== 运行参数 =====
# 宿主机映射端口
APP_PORT=3000
TZ=Asia/Shanghai
LOG_LEVEL=info

# ===== 镜像 =====
# 直接拉取 GHCR 上的已构建镜像（公开仓库，无需 docker login）
IMAGE=ghcr.io/rdevils7/tgsub:latest
# 需要固定版本时改这里，例如 ghcr.io/rdevils7/tgsub:v1.0.0

# ===== 持久化目录（宿主机路径）=====
# ① 数据持久化目录 → 容器 /data
#    存放：SQLite 数据库(tgsub.db)、加密后的 Telegram session、
#          会话密钥(.session-secret)、封面缓存(covers)、临时截图(frames)、日志
#    换容器 / 重装镜像都不丢；备份这个目录即可恢复全部配置与记录
DATA_HOST_DIR=./data

# ② 下载目录 → 容器 /downloads
#    存放：实际下载的媒体文件（视频 / 图片 / nfo / 封面），按 {date}/{channel}/{name} 归档
#    体积大，可单独指向另一块大容量磁盘
DOWNLOAD_HOST_DIR=./downloads

# ===== 安全 =====
# 加密 Telegram session 的密钥（>=16 位）。
# 留空时会在数据目录自动生成 /data/.session-secret，请勿随意更换，否则需重新登录。
SESSION_SECRET=

# 管理界面基础认证（可选，公网部署强烈建议开启）
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# ===== 构建（仅 docker-compose.build.yml 本地构建时用）=====
# 国内网络可改为 https://registry.npmmirror.com
NPM_REGISTRY=https://registry.npmjs.org
