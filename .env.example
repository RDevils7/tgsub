# ===== 运行参数 =====
# 说明：Docker Compose 部署不使用本文件（compose 里已全部写成真实值）。
#       本文件仅供「本地直接运行 node server/dist/index.js」时使用，
#       程序启动时会自动加载项目根目录下的 .env。

# 监听端口
PORT=6789
TZ=Asia/Shanghai
LOG_LEVEL=info

# ===== 目录 =====
# 本地运行时数据默认写在 ./data，下载文件在 ./data/downloads
# DATA_DIR=./data
# DOWNLOAD_DIR=./data/downloads
# DB_FILE=./data/tgsub.db

# ===== 安全 =====
# 加密 Telegram session 的密钥（>=16 位）。
# 留空时会在数据目录自动生成 /data/.session-secret，请勿随意更换，否则需重新登录。
SESSION_SECRET=

# 管理界面基础认证（可选，公网部署强烈建议开启）
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
